# Copy this file to .env and fill in your own values.

# Backend URLs
VITE_API_URL=http://localhost:3000/api
VITE_AI_BACKEND_URL=http://localhost:8002

# Firebase web config (Firebase console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# The Python backend in echoplex-backend/ also needs a Firebase service
# account file saved as echoplex-backend/serviceAccountKey.json (never commit it).
